# acp-vessel runtime environment. The host injects this (compose env_file rendered from Infisical, or a 0600 file).
# The vessel never talks to a vault itself.

# --- buzz (identity on the relay) ---
BUZZ_RELAY_URL=wss://buzz.example.dev
BUZZ_PRIVATE_KEY=<agent nsec, hex>
BUZZ_ACP_AGENT_OWNER=<owner pubkey, hex>
BUZZ_ACP_RESPOND_TO=owner-only
BUZZ_ACP_SESSION_TITLE=hub

# --- harness selection ---
BUZZ_ACP_AGENT_COMMAND=claude-agent-acp      # or codex-acp
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_MODEL=

# --- credentials (one per harness; only the active one is used) ---
CLAUDE_CODE_OAUTH_TOKEN=<claude setup-token>  # Claude subscription, 1 year
# Codex: run `codex login --device-auth` once inside the container; auth.json lives in the /home/agent/.codex volume

# --- git (HTTPS; a fine-grained token scoped to the identity + work repos, contents: read/write) ---
VESSEL_GIT_TOKEN=<token>
VESSEL_GIT_HOST=github.com
VESSEL_GIT_USER=x-access-token
VESSEL_IDENTITY_REPO=https://github.com/org/basphere-agent-hub.git
VESSEL_WORK_REPOS=https://github.com/org/basphere-hub.git https://github.com/org/hermod.git
VESSEL_WORK_DIR=/work/basphere-hub
VESSEL_GIT_NAME=hub-agent
VESSEL_GIT_EMAIL=hub-agent@example.dev

# --- memory autosave backstop (seconds; the agent still commits at wrap-up) ---
VESSEL_AUTOSAVE_INTERVAL=600
